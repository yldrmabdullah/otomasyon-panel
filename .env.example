# --- Parkoil Otomasyon Paneli — ortam değişkenleri ---
# Bu dosyayı .env olarak kopyala ve doldur. .env commit EDİLMEZ.
# GitHub Actions'ta bunlar repo Secrets olarak tanımlanır.

# ASIS POL SOAP web servisi
# GUID_KEY bir SIRDIR — bu şablona yazılmaz, gerçek değer SIRLAR.local.md'de.
ASIS_GATEWAY=https://pol.parkoil.tr/Poservice/gateway.asmx
ASIS_GUID_KEY=
ASIS_DAGITICI_KOD=21
ASIS_NAMESPACE=http://www.asis.com.tr/

# Postgres (Supabase / Neon connection string)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# BFF (bayi iletişim — canlı Logo'dan telefon/mail)
BFF_URL=https://reportapi.parkoil.com.tr
BFF_API_KEY=

# Alarm eşikleri (opsiyonel — kod içi varsayılanlar var)
KOPUK_ESIK_SAAT=3
TANK_VERI_ESIK_DK=35
# Aynı açık alarm için tekrar-bildirim aralığı (saat)
TEKRAR_BILDIRIM_SAAT=6
# Son bu kadar günden eski veri gönderen istasyon "pasif/ölü" → alarm atılmaz
PASIF_ESIK_GUN=7

# ⭐ BİLDİRİM eşiği — ALARM eşiğinden AYRI (ölçülerek belirlendi, 2026-08-04).
# Tank alarmı 35 dk'da açılır ve panelde görünür, ama mail 3 saat beklenir:
# alarmların %63'ü 30 dakikada kendiliğinden kapanıyor (flapping).
#   eşik 35dk → 7 günde 1.915 mail  ·  2 sa → 192  ·  3 sa → 49 (44 tekil tank)
BILDIRIM_TANK_ESIK_SAAT=3

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=otomasyon@parkoil.com.tr
# Ekip dağıtım listesi (virgülle ayrılmış)
EKIP_MAIL=otomasyon@parkoil.com.tr

# SMS (Netgsm)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=PARKOIL
# Ekip nöbetçi telefon(lar), virgülle ayrılmış (opsiyonel)
EKIP_TELEFON=

# ⚠️⚠️ BAYİLERE gönderim — VARSAYILAN KAPALI (bilinçli).
# 0 = bildirim yalnız EKIP_MAIL / EKIP_TELEFON'a gider (178 bayi telefonu ve
#     168 bayi maili DB'de hazır ama KULLANILMAZ).
# 1 = bayilere de gider. Açmadan önce bildirim eşiği canlıda birkaç gün
#     izlenmeli: yanlış giden mesaj geri alınamaz ve bayi güvenini yıkar
#     (CLAUDE.md: "yanlış alarm bayiyi yorar"). Ölçüm: tek istasyon 24 saatte
#     51 alarm üretti.
BAYIYE_GONDER=0

# Çalışma modu: DRY_RUN=1 ise bildirim GÖNDERMEZ, sadece loglar (test için)
DRY_RUN=1

# ── A3 ↔ Logo mutabakatı (araclar/a3Kiyas.mts + .github/workflows/a3-mutabakat.yml) ──
# POL girişi (A3 raporu indirmek için — Playwright). CAPTCHA/2FA yok, saf giriş.
# Logo tarafı yukarıdaki BFF_URL/BFF_API_KEY üstünden gelir (dış API X-Api-Key).
POL_URL=https://pol.parkoil.tr/POL/
POL_KULLANICI=
POL_SIFRE=

# ⭐ TERS YÖN dış API (2026-09-02, Dorse Durum Kontrol Sistemi) — BFF_API_KEY'in tersi:
# BFF bizim mutabakat_irsaliye tablosunu (api/dis-v1-dorse-hareketleri.ts) bu anahtarla
# okur (X-Api-Key başlığı). En az 32 karakter, rastgele üret (PANEL_OTURUM_SIRRI gibi).
DIS_API_ANAHTARI=
