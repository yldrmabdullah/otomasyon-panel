{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd panel && npm install && npm run build",
  "outputDirectory": "panel/dist",
  "functions": {
    "panel/api/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/durum", "destination": "/panel/api/durum" },
    { "source": "/api/piyasa", "destination": "/panel/api/piyasa" },
    { "source": "/api/bayiler", "destination": "/panel/api/bayiler" },
    { "source": "/api/giris", "destination": "/panel/api/giris" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
