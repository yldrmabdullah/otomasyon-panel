{
  "name": "parkoil-otomasyon-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parkoil otomasyon izleme + alarm sistemi (ASIS POL bağlantı/tank takibi, mail+SMS alarm)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "job": "tsx job/index.ts",
    "a3": "tsx araclar/a3Kiyas.mts",
    "uzlas": "tsx araclar/uzlasCek.mts",
    "dissatis": "tsx araclar/dissatisCek.mts",
    "piyasa": "tsx araclar/piyasaCek.ts --tum-durumlar",
    "job:build": "tsc -p tsconfig.json",
    "db:migrate": "tsx core/migrate.ts",
    "typecheck": "tsc --noEmit",
    "panel:api": "tsx araclar/panelSunucu.ts",
    "kullanici": "tsx araclar/kullaniciHash.ts",
    "mobil": "tsx araclar/mobilTest.ts",
    "satis": "tsx araclar/satisCek.ts",
    "seviye": "tsx araclar/seviyeCek.ts",
    "piyasa:mail": "tsx araclar/piyasaMail.ts",
    "kolon:test": "tsx araclar/kolonMenuTest.ts",
    "fiyat": "tsx araclar/fiyatKiyas.mts",
    "a1b": "tsx araclar/a1bCek.mts",
    "hacim": "tsx araclar/hacimCek.ts",
    "satis:fatura": "tsx araclar/satisFaturaCek.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "mssql": "^12.7.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^58.1.0"
  }
}
